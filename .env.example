# Copy to .env and fill in. Never commit .env.

# ---- Agora (console.agora.io) ----
AGORA_APP_ID=                 # Project > App ID
AGORA_APP_CERTIFICATE=        # Project > App Certificate (enable "Secured mode: APP ID + Token")
AGORA_CUSTOMER_ID=            # Developer Toolkit > RESTful API > Customer ID  (Basic auth for ConvoAI REST)
AGORA_CUSTOMER_SECRET=        # Developer Toolkit > RESTful API > Customer Secret (shown once - save it)
# Also: enable "Conversational AI" for the project in the console.

# ---- Murf (murf.ai/api dashboard) ----
MURF_API_KEY=
MURF_VOICE_ID=hi-IN-poonam                # Falcon voice covering en, hi, kn, mr, ta, te, bn, gu, ml, pa, as, or (see list_voices.py)
MURF_MODEL=falcon-2.1          # verified: Murf voices API accepts only gen2, falcon-2.1

# ---- Sarvam (dashboard.sarvam.ai) - ASR, Murf is not an Agora ASR vendor ----
SARVAM_API_KEY=

# ---- Upstream LLM behind our custom /llm/chat/completions (any OpenAI-compatible API) ----
LLM_BASE_URL=                 # e.g. https://api.openai.com/v1  or another OpenAI-compatible base URL
LLM_API_KEY=
LLM_MODEL=                    # pick a fast model: time-to-first-token matters more than raw quality

# ---- Our backend ----
PUBLIC_BASE_URL=              # https URL of the tunnel to localhost:8000 (cloudflared / ngrok); Agora cloud must reach it
CUSTOM_LLM_SHARED_KEY=change-me   # Agora sends this as llm.api_key -> we check the Bearer header
